<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmployeeManagement">

        <!-- Login Activity (Launcher) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Admin Activities -->
        <activity android:name=".ui.admin.AdminDashboardActivity" android:exported="false"/>
        <activity android:name=".ui.admin.EmployeeListActivity" android:exported="false"/>
        <activity android:name=".ui.admin.AddEditEmployeeActivity" android:exported="false"/>
        <activity android:name=".ui.admin.SalaryManagementActivity" android:exported="false"/>
        <activity android:name=".ui.admin.AttendanceReportActivity" android:exported="false"/>

        <!-- Employee Activities -->
        <activity android:name=".ui.employee.EmployeeDashboardActivity" android:exported="false"/>
        <activity android:name=".ui.employee.CheckInOutActivity" android:exported="false"/>
        <activity android:name=".ui.employee.AttendanceHistoryActivity" android:exported="false"/>
        <activity android:name=".ui.employee.SalaryDetailActivity" android:exported="false"/>
        <activity android:name=".ui.employee.ProfileActivity" android:exported="false"/>

    </application>

</manifest>
